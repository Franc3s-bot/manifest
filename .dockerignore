node_modules/
# A worktree can expose per-package node_modules as a symlink; the trailing
# slash above only matches directories, so exclude the symlink form too —
# otherwise COPY clobbers the installed deps with a broken host symlink.
packages/*/node_modules
.git/
.github/
.changeset/
.claude/
.husky/
.vscode/
.turbo/
dist/
build/
coverage/
*.log
.env*
.DS_Store
*.tsbuildinfo
*.tmp
*.swp
railway.toml
codecov.yml
CODE_OF_CONDUCT.md
CONTRIBUTING.md
SECURITY.md
CLAUDE.md
LICENSE

# Test files
packages/backend/test/
packages/frontend/tests/
packages/shared/src/**/*.spec.ts
packages/backend/src/**/*.spec.ts
